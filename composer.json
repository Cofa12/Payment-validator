{
    "name": "appssquare/payment-validator",
    "description": "Extensible signature/authenticity validation for payment gateway callbacks and webhooks (Paymob, EasyKash, HyperPay, Kashier, ...).",
    "keywords": ["payment", "webhook", "signature", "hmac", "paymob", "kashier", "easykash", "hyperpay"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahmoud Gamal",
            "email": "appssquareacc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Appssquare\\PaymentValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appssquare\\PaymentValidator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
